# Bootstrap: first call requests exactly what's needed (no buffer).
# bufferNanos seeded to min(100µs, 1ms) = 100µs for next time.
refill diff=100µs
----
buffer: 100µs, total: 100µs

# Second call: requests diff + buffer. bufferNanos doubled to 200µs.
refill diff=100µs
----
buffer: 200µs, total: 200µs

# Third call: buffer=200µs. bufferNanos doubled to 400µs.
refill diff=100µs
----
buffer: 400µs, total: 300µs

# Fourth call: buffer=400µs. bufferNanos doubled to 800µs.
refill diff=100µs
----
buffer: 800µs, total: 500µs

# Converge to cap (maxBufferNanos = 1ms).
refill diff=100µs
----
buffer: 1ms, total: 900µs

# At cap: buffer stays at 1ms.
refill diff=100µs
----
buffer: 1ms, total: 1.1ms

# Large diff: buffer still capped, total = diff + buffer.
refill diff=50ms
----
buffer: 1ms, total: 51ms

# Reset buffer to 0 to test re-bootstrap.
set-buffer val=0
----
ok

# Re-bootstrap: first call after reset requests exactly what's needed.
refill diff=200µs
----
buffer: 200µs, total: 200µs

# Growth resumes from seeded value.
refill diff=200µs
----
buffer: 400µs, total: 400µs

refill diff=200µs
----
buffer: 800µs, total: 600µs

refill diff=200µs
----
buffer: 1ms, total: 1ms

# Small buffer, small diff: exponential growth from small values.
set-buffer val=10µs
----
ok

refill diff=50µs
----
buffer: 20µs, total: 60µs

refill diff=50µs
----
buffer: 40µs, total: 70µs

refill diff=50µs
----
buffer: 80µs, total: 90µs

refill diff=50µs
----
buffer: 160µs, total: 130µs

refill diff=50µs
----
buffer: 320µs, total: 210µs

refill diff=50µs
----
buffer: 640µs, total: 370µs

refill diff=50µs
----
buffer: 1ms, total: 690µs

# At cap, stays at cap.
refill diff=50µs
----
buffer: 1ms, total: 1.05ms

refill diff=50µs
----
buffer: 1ms, total: 1.05ms
