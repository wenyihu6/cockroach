# Simple tryGet calls.
init noburst=1
----
cpuTTG  can_burst no_burst
buckets 0         1
requester: waitingRequests: false, returnValueFromHasWaitingRequests: no_burst, returnValueFromGranted: 0

try-get v=1
----
kvreq: tryGet(1) returned true
cpuTTG  can_burst no_burst
buckets -1        0

try-get v=1
----
kvreq: tryGet(1) returned false

# Returns tokens used since last call to reset-tokens-used.
# Since only one try-get v=1 succeeded, only one token used.
reset-tokens-used
----
reset-tokens-used-in-interval() returned 1

# Since reset-tokens-used just called, should return zero.
reset-tokens-used
----
reset-tokens-used-in-interval() returned 0

# More tryGet calls. Both burst and noburst have tokens.
init canburst=2 noburst=1
----
cpuTTG  can_burst no_burst
buckets 2         1
requester: waitingRequests: false, returnValueFromHasWaitingRequests: no_burst, returnValueFromGranted: 0

# continueGrantChain is a NOP for cpuTimeTokenGranter. Still,
# test it doesn't panic.
continue-grant-chain
----
kvreq: continueGrantChain

try-get v=1
----
kvreq: tryGet(1) returned true
cpuTTG  can_burst no_burst
buckets 1         0

try-get v=1
----
kvreq: tryGet(1) returned false

# Since only one try-get v=1 succeeded, should return one.
reset-tokens-used
----
reset-tokens-used-in-interval() returned 1

# returnGrant adds tokens to the buckets, when a positive count is used.
init canburst=0 noburst=1
----
cpuTTG  can_burst no_burst
buckets 0         1
requester: waitingRequests: false, returnValueFromHasWaitingRequests: no_burst, returnValueFromGranted: 0

return-grant v=1
----
kvreq: returnGrant(1)
cpuTTG  can_burst no_burst
buckets 1         2

try-get burst v=1
----
kvreq: tryGet(1) returned true
cpuTTG  can_burst no_burst
buckets 0         1

try-get v=1
----
kvreq: tryGet(1) returned true
cpuTTG  can_burst no_burst
buckets -1        0

# The net of one return-grant v=1 with two try-gets v=1 is one
# token used.
reset-tokens-used
----
reset-tokens-used-in-interval() returned 1

# Simple tookWithoutPermission test.
init canburst=3 noburst=3
----
cpuTTG  can_burst no_burst
buckets 3         3
requester: waitingRequests: false, returnValueFromHasWaitingRequests: no_burst, returnValueFromGranted: 0

took-without-permission v=3
----
kvreq: tookWithoutPermission(3)
cpuTTG  can_burst no_burst
buckets 0         0

try-get v=1
----
kvreq: tryGet(1) returned false

try-get burst v=1
----
kvreq: tryGet(1) returned false

# took-without-permission v=3 is the only successful call, so three tokens used.
reset-tokens-used
----
reset-tokens-used-in-interval() returned 3

# Test granting. A request will be admitted.
init waiter=2
----
requester: waitingRequests: true, returnValueFromHasWaitingRequests: no_burst, returnValueFromGranted: 2

return-grant v=2
----
kvreq: returnGrant(2)
kvreq: granted in chain 0, and returning 2

# The net of one return-grant v=2 with that grant leading to admission of request
# with token count equal to two is zero tokens used.
reset-tokens-used
----
reset-tokens-used-in-interval() returned 0

# Test granting. Two requests will be admitted.
init canburst=-1 noburst=-1 waiter=1
----
cpuTTG  can_burst no_burst
buckets -1        -1
requester: waitingRequests: true, returnValueFromHasWaitingRequests: no_burst, returnValueFromGranted: 1

# With three returned, noburst will have two tokens. Thus two
# requests can be granted admission. Note that the test requester is not
# stateful. In init, waiter=1 means the requester always has a waiting
# request, and the ret value from granted is always 1. Thus, after two requests
# are granted admission, the bucket is empty again.
return-grant v=3
----
kvreq: returnGrant(3)
kvreq: granted in chain 0, and returning 1
kvreq: granted in chain 0, and returning 1
cpuTTG  can_burst no_burst
buckets 0         0

# The net of one return-grant v=3 with that grant leading to admission of two requests
# with token count equal to one is -1 tokens used.
reset-tokens-used
----
reset-tokens-used-in-interval() returned -1

# Simple tryGet calls, with burst this time.
init canburst=1
----
cpuTTG  can_burst no_burst
buckets 1         0
requester: waitingRequests: false, returnValueFromHasWaitingRequests: no_burst, returnValueFromGranted: 0

try-get v=1
----
kvreq: tryGet(1) returned false

try-get burst v=1
----
kvreq: tryGet(1) returned true
cpuTTG  can_burst no_burst
buckets 0         -1

try-get burst v=1
----
kvreq: tryGet(1) returned false

# Since one try-get v=1 succeeded, should return one.
reset-tokens-used
----
reset-tokens-used-in-interval() returned 1

# Test granting, with burst. After the call to return-grant, only canBurst will
# have enough tokens to grant. So grant a request.
init canburst=-1 noburst=-1 waiter=1 burstwaiter
----
cpuTTG  can_burst no_burst
buckets -1        -1
requester: waitingRequests: true, returnValueFromHasWaitingRequests: can_burst, returnValueFromGranted: 1

return-grant v=2
----
kvreq: returnGrant(2)
kvreq: granted in chain 0, and returning 1
cpuTTG  can_burst no_burst
buckets 0         0

# The net of one return-grant v=2 with that grant leading to admission of one request
# with token count equal to one is -1 tokens used.
reset-tokens-used
----
reset-tokens-used-in-interval() returned -1

# Test granting, with burst. After the call to return-grant, only noBurst will
# have enough tokens to grant. So no grant, since the waiting request is a burst request.
init canburst=-1 noburst=0 waiter=1 burstwaiter
----
cpuTTG  can_burst no_burst
buckets -1        0
requester: waitingRequests: true, returnValueFromHasWaitingRequests: can_burst, returnValueFromGranted: 1

return-grant v=1
----
kvreq: returnGrant(1)
cpuTTG  can_burst no_burst
buckets 0         1

# The net of one return-grant v=1 with that grant not leading to any admission is
# -1 tokens used.
reset-tokens-used
----
reset-tokens-used-in-interval() returned -1

# Test refill, which is the interface cpuTimeTokenFiller uses to add tokens to
# the buckets. Note that there is a single non-burstable request waiting
# for admission.
init waiter=1
----
cpuTTG  can_burst no_burst
buckets 0         0
requester: waitingRequests: true, returnValueFromHasWaitingRequests: no_burst, returnValueFromGranted: 1

# The arguments to refill are hard-coded in the test code, but they are also
# shown in the below output. The corresponding entry in delta is added to every
# bucket, subject to a max capacity of the corresponding entry in cap and a min
# floor of the corresponding entry in min. Note as per the call init above,
# there is one non-burstable request waiting for admission. Due to the
# call to refill, it is granted admission, as can be seen in the output below.
# So one token is deducted from all buckets, post the deltas being added.
# For example, can_burst was 0, then 5 is added to it (cap of 20 is not applied),
# then 1 token is deducted, so the final state is 5-1 = 4.
refill
----
kvreq: granted in chain 0, and returning 1
kvreq: granted in chain 0, and returning 1
kvreq: granted in chain 0, and returning 1
kvreq: granted in chain 0, and returning 1
refill(
	can_burst -> delta: 5, cap: 20, min: 0
	no_burst -> delta: 4, cap: 16, min: -4
)
cpuTTG  can_burst no_burst
buckets 1         0

# Refilling the buckets does not count as token usage. The only usage that happens
# here is that one request with token count equal to one is granted admission, due to
# the refill (see "granted in..." message above). So one token used.
reset-tokens-used
----
reset-tokens-used-in-interval() returned 4

# Test that refill enforces both ceiling and floor. canBurst starts at 16,
# so 16 + delta(5) = 21 > cap(20), demonstrating the ceiling. noBurst starts
# deeply negative, so it is clamped to its floor of -4.
init noburst=-100 canburst=16
----
cpuTTG  can_burst no_burst
buckets 16        -100
requester: waitingRequests: false, returnValueFromHasWaitingRequests: no_burst, returnValueFromGranted: 0

refill
----
refill(
	can_burst -> delta: 5, cap: 20, min: 0
	no_burst -> delta: 4, cap: 16, min: -4
)
cpuTTG  can_burst no_burst
buckets 20        -4
