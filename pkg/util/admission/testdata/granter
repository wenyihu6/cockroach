(chain: id: 2 active: false index: 1) kv: used: 2, total: 2
SlotAdjuster metrics: slots: 2, duration (short, long) millis: (1, 0), inc: 1, dec: 0

# kv slots increased to 3. There are waiting requests so a grant happens.
set-has-waiting-requests work=kv v=true
----
GrantCoordinator:
(chain: id: 2 active: false index: 1) kv: used: 2, total: 2

cpu-load runnable=0 procs=1
----
kv: granted in chain 2, and returning 0
GrantCoordinator:
(chain: id: 2 active: false index: 1) kv: used: 2, total: 3
SlotAdjuster metrics: slots: 3, duration (short, long) millis: (2, 0), inc: 2, dec: 0

# Overload and kv slots decreased. Forces termination of grant chain 2.
cpu-load runnable=2 procs=1
----
GrantCoordinator:
(chain: id: 2 active: false index: 0) kv: used: 2, total: 2
SlotAdjuster metrics: slots: 2, duration (short, long) millis: (3, 0), inc: 2, dec: 1

# Grant chain 2 terminates.
continue-grant-chain work=kv
----
kv: continueGrantChain
GrantCoordinator:
(chain: id: 2 active: false index: 0) kv: used: 2, total: 2

# Underload and kv slots increased.
cpu-load runnable=2 procs=4
----
kv: granted in chain 0, and returning 0
GrantCoordinator:
(chain: id: 2 active: false index: 1) kv: used: 2, total: 3
SlotAdjuster metrics: slots: 3, duration (short, long) millis: (4, 0), inc: 3, dec: 1

# Continue grant chain — no more waiting.
set-has-waiting-requests work=kv v=false
----
GrantCoordinator:
(chain: id: 2 active: false index: 1) kv: used: 2, total: 3

continue-grant-chain work=kv
----
kv: continueGrantChain
GrantCoordinator:
(chain: id: 2 active: false index: 1) kv: used: 2, total: 3

#####################################################################
# Test skipping of enforcements when CPULoad has high sampling period.
init-grant-coordinator min-cpu=1 max-cpu=3
----
GrantCoordinator:
(chain: id: 1 active: false index: 0) kv: used: 0, total: 1

# No more slots after this slot is granted.
try-get work=kv
----
kv: tryGet(1) returned true
GrantCoordinator:
(chain: id: 1 active: false index: 0) kv: used: 1, total: 1

# Since no more KV slots, cannot grant.
try-get work=kv
----
kv: tryGet(1) returned false
GrantCoordinator:
(chain: id: 1 active: false index: 0) kv: used: 1, total: 1

# CPULoad shows overload, so cannot increase KV slots, but since it is
# infrequent, slot enforcement is disabled.
cpu-load runnable=20 procs=1 infrequent=true
----
GrantCoordinator:
(chain: id: 1 active: false index: 1) kv: used: 1, total: 1
SlotAdjuster metrics: slots: 1, duration (short, long) millis: (0, 250), inc: 0, dec: 0

# KV can get another slot even though slots are exhausted.
try-get work=kv
----
kv: tryGet(1) returned true
GrantCoordinator:
(chain: id: 1 active: false index: 1) kv: used: 2, total: 1
